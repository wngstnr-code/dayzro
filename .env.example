# Single env file for the whole repo (contracts + frontend). Copy to .env and fill in.
# contracts/.env and web/.env are symlinks to this file.

# --- Arc mainnet ---
ARC_RPC_URL=https://rpc.mainnet.arc.io
ARC_CHAIN_ID=5042
USDC_ADDRESS=0x3600000000000000000000000000000000000000
EURC_ADDRESS=0xbEf5f6d51CB62b58e6A8f77868681825C6fe21c1

# --- Deployer (never commit a real key) ---
DEPLOYER_PRIVATE_KEY=
PROTOCOL_OWNER=
PROTOCOL_TREASURY=
PROTOCOL_FEE_BPS=25

# --- Deployed contracts (filled after deploy; read by the frontend) ---
NEXT_PUBLIC_CHAIN_ID=5042
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.arc.io
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_FACILITY_ADDRESS=
